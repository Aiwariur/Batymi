# =============================================================================
# Batymi — движок ответов собственникам (долгосрочная аренда, SS.GE-Rent CRM)
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# NEVER commit the real `.env` file.
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# --- Redis -------------------------------------------------------------------
# Inside docker compose use redis://redis:6379
# For a locally running redis use redis://localhost:6379
REDIS_URL=redis://redis:6379

# --- Behaviour tuning --------------------------------------------------------
# How long to wait for the user to stop typing before processing a batch.
MESSAGE_DEBOUNCE_MS=10000
# BullMQ worker concurrency (how many conversations are processed in parallel).
WORKER_CONCURRENCY=20
# How many recent messages to keep per conversation (chat context only).
CONVERSATION_HISTORY_MAX_MESSAGES=30
# TTL of stored conversation history.
CONVERSATION_HISTORY_TTL_DAYS=30
# Distributed lock TTL for a single conversation.
CONVERSATION_LOCK_TTL_MS=120000
# How long a processed GreenAPI idMessage is remembered (idempotency).
IDEMPOTENCY_TTL_SECONDS=86400

# --- CRM (арендная CRM SS.GE-Rent) --------------------------------------------
# API-ключ = N8N_API_KEY этой CRM (тот же, что носил n8n/Hermes).
CRM_BASE_URL=https://admin.batumi-key.homes/api
CRM_API_KEY=

# GreenAPI webhookUrlToken. In production GreenAPI sends this as:
# Authorization: Bearer <GREENAPI_WEBHOOK_SECRET>
GREENAPI_WEBHOOK_SECRET=
GREENAPI_WEBHOOK_SECRET_HEADER=authorization

# --- LLM ---------------------------------------------------------------------
# LLM_PROVIDER can be any OpenAI-compatible provider: openai, openrouter, ...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
LLM_API_KEY=
# OpenAI-compatible base URL, must include /v1
LLM_BASE_URL=https://api.openai.com/v1
# Audio transcription model (OpenAI-compatible endpoint).
TRANSCRIPTION_MODEL=whisper-1

# --- GreenAPI ----------------------------------------------------------------
# Batymi только ПРИНИМАЕТ вебхуки (и проксирует их в CRM). Отправка ответов
# идёт через CRM /api/chat/reply, поэтому токены инстансов НЕ нужны —
# только id инстансов, которым разрешено слать вебхуки на этот сервис.
# Option A (recommended): JSON array of instances.
# GREENAPI_INSTANCES=[{"id":"7107577616","managerId":2}]
# Option B: numbered variables. Add as many as you need.
GREENAPI_INSTANCE_1_ID=
GREENAPI_INSTANCE_1_MANAGER_ID=
# GREENAPI_INSTANCE_2_ID=
# GREENAPI_INSTANCE_2_MANAGER_ID=

# --- Business rules ----------------------------------------------------------
# Агент обслуживает диалоги, где ответственный — AI-менеджер (Manager.is_ai,
# флаг assigned_manager_is_ai от CRM; назначается CRM при первой отправке).
# Этот список — легаси-fallback для старой CRM без флага (пусто = все менеджеры).
ALLOWED_MANAGER_IDS=
# CRM statuses that stop the qualification flow (no reply, no LLM call).
TERMINAL_CRM_STATUSES=disagreed,archived,no_whatsapp

# --- Mock mode ---------------------------------------------------------------
# When true, no real CRM / LLM credentials are required.
MOCK_EXTERNALS=true
# Optional per-service overrides. If omitted they inherit MOCK_EXTERNALS.
# MOCK_CRM=true
# MOCK_LLM=true
# MOCK_TRANSCRIPTION=true

# --- Process roles -----------------------------------------------------------
# Run the HTTP API and/or the BullMQ worker in this process.
API_ENABLED=true
WORKER_ENABLED=true
QUEUE_NAME=conversation

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=debug
# Log full message contents (dev only, never enable in production).
LOG_MESSAGE_CONTENT=false

# LLM safety cap per request
LLM_MAX_TOKENS=4096

# LLM sampling (lower temperature / penalty = stabler scenario adherence)
LLM_TEMPERATURE=0.5
LLM_FREQUENCY_PENALTY=0.5
LLM_TOP_P=0.9
